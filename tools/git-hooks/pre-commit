#!/bin/sh
# Refuse any staged file over 5 MB (big generated files bloated .git to 66 GB once).
# Installed by: git config core.hooksPath tools/git-hooks
limit=5242880
big=$(git diff --cached --name-only --diff-filter=AM -z | xargs -0 -I{} sh -c 's=$(git cat-file -s ":{}" 2>/dev/null || echo 0); [ "$s" -gt '$limit' ] && echo "  {} ($s bytes)"')
if [ -n "$big" ]; then
  echo "pre-commit: refusing files over 5 MB (build outputs / voice packs don't belong in git):"
  echo "$big"
  exit 1
fi
