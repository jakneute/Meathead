{
  "name": "meathead",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "release": "vite build --mode release && node -e \"require('fs').renameSync('release/index.html','release/Meathead.html')\"",
    "voices": "esbuild tools/voices/extract.ts --bundle --platform=node --format=cjs --outfile=tools/voices/.extract.cjs --external:typescript --log-level=error && node tools/voices/.extract.cjs && tools/voices/.venv/Scripts/python.exe tools/voices/generate.py"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@tailwindcss/vite": "^4.2.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
