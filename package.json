{
  "name": "meathead",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "release": "node tools/release/build.mjs",
    "release:public": "node tools/release/build.mjs m1",
    "release:m2": "node tools/release/build.mjs m2",
    "release:steam": "vite build --mode steam && node tools/steam/package.mjs",
    "icon": "node tools/icon/make.mjs",
    "voices": "node tools/voices/run.cjs",
    "voices:m2": "node node_modules/esbuild/bin/esbuild tools/voices/m2pack.ts --bundle --platform=node --format=cjs --outfile=tools/voices/.m2pack.cjs --log-level=error --loader:.bin=empty --loader:.png=dataurl && node tools/voices/.m2pack.cjs",
    "voices:m1": "node tools/voices/m1pack.cjs",
    "release:m1": "node tools/release/build.mjs m1"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@tailwindcss/vite": "^4.2.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "electron": "^44.7.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
